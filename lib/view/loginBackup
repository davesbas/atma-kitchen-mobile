import 'package:flutter/material.dart';
import 'package:atma_kitchen_mobile/view/manajerOperasional/presensiView.dart'; // Import presensiView.dart
import 'package:atma_kitchen_mobile/view/customer/customerView.dart'; // Import customerView.dart

class LoginView extends StatefulWidget {
  @override
  _LoginViewState createState() => _LoginViewState();
}

class _LoginViewState extends State<LoginView> {
  bool _obscurePassword = true;

  // Simulated user data with job ID
  Map<String, int> users = {
    '1@g.com': 1, // Job ID 1 for Manager
    '2@g.com': 2, // Job ID 2 for Customer
  };

  // Controller for email field
  TextEditingController _emailController = TextEditingController();
  // Controller for password field
  TextEditingController _passwordController = TextEditingController();

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text('Login'),
        backgroundColor: Color.fromRGBO(240, 240, 240, 240),
      ),
      body: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            TextFormField(
              controller: _emailController,
              decoration: InputDecoration(
                labelText: 'Email',
                prefixIcon: Icon(Icons.email),
              ),
            ),
            TextFormField(
              controller: _passwordController,
              decoration: InputDecoration(
                labelText: 'Password',
                prefixIcon: Icon(Icons.lock),
                suffixIcon: IconButton(
                  icon: _obscurePassword
                      ? Icon(Icons.visibility)
                      : Icon(Icons.visibility_off),
                  onPressed: () {
                    setState(() {
                      _obscurePassword = !_obscurePassword;
                    });
                  },
                ),
              ),
              obscureText: _obscurePassword,
            ),
            SizedBox(height: 20),
            ElevatedButton(
              onPressed: () {
                // Logic for login
                String email = _emailController.text.trim();
                String password = _passwordController.text.trim();
                int? jobId = users[email];
                // Check if user exists and job ID is valid
                if (jobId != null) {
                  // Navigate based on job ID
                  if (jobId == 1) {
                    // Navigate to Manager Operational PresensiView
                    Navigator.push(
                      context,
                      MaterialPageRoute(builder: (context) => AttendanceManagementPage()),
                    );
                  } else if (jobId == 2) {
                    // Navigate to CustomerViewPage
                    Navigator.push(
                      context,
                      MaterialPageRoute(builder: (context) => customerViewPage()),
                    );
                  }
                } else {
                  // Show error message for invalid login
                  showDialog(
                    context: context,
                    builder: (BuildContext context) {
                      return AlertDialog(
                        title: Text('Error'),
                        content: Text('Invalid email or password.'),
                        actions: <Widget>[
                          TextButton(
                            onPressed: () {
                              Navigator.of(context).pop();
                            },
                            child: Text('Close'),
                          ),
                        ],
                      );
                    },
                  );
                }
              },
              child: Text('Login'),
            ),
          ],
        ),
      ),
    );
  }
}
